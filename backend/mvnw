# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.2.0
# ----------------------------------------------------------------------------

# If $JAVA_HOME is set, use it, otherwise use java from PATH
if [ -n "$JAVA_HOME" ]; then
    JAVA_HOME="${JAVA_HOME}"
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# Download maven-wrapper.jar if not present
WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$WRAPPER_PROPERTIES" ]; then
    WRAPPER_URL=$(grep "wrapperUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

if [ ! -f "$WRAPPER_JAR" ]; then
    if command -v wget > /dev/null; then
        wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL" || true
    elif command -v curl > /dev/null; then
        curl -q -L -o "$WRAPPER_JAR" "$WRAPPER_URL" || true
    fi
fi

# If we can run with the wrapper jar
if [ -f "$WRAPPER_JAR" ]; then
    exec "$JAVACMD" \
        -classpath "$WRAPPER_JAR" \
        "-Dmaven.multiModuleProjectDirectory=$(dirname "$0")" \
        org.apache.maven.wrapper.MavenWrapperMain "$@"
fi

# Fall back to system mvn
if command -v mvn > /dev/null 2>&1; then
    exec mvn "$@"
fi

echo "ERROR: Could not find mvn or maven-wrapper.jar" >&2
exit 1
